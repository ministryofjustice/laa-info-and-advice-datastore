DB_USERNAME=laa_user
DB_PASSWORD=laa_password

# For local development using the mock OAuth2 server (docker-compose up -d mock-oauth2-server):
LAA_OAUTH2_ISSUER_URI=http://host.docker.internal:9090/default

# If you're using the mock oauth server, it expects this value to always be `default`, otherwise
# it will throw 401 with invalid audience.
# LAA_OAUTH2_AUDIENCE=api://laa-info-and-advice-datastore

# Sentry error monitoring - set SENTRY_ENABLED=false to disable all Sentry SDK features.
SENTRY_ENABLED=true
SENTRY_LOGS_ENABLED=true
# Set the trace sample rate to 0 to disable tracing, or a value from 0 to 1 to sample traces.
SENTRY_TRACES_SAMPLE_RATE=0.01

# Leave the DSN blank to disable event delivery. Get these from Sentry project settings.
SENTRY_DSN=
SENTRY_CSP_REPORT_URI=
SENTRY_SECURITY_TOKEN=
