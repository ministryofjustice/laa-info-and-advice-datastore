DB_USERNAME=laa_user
DB_PASSWORD=laa_password

# For local development using the mock OAuth2 server (docker-compose up -d mock-oauth2-server):
LAA_OAUTH2_ISSUER_URI=http://localhost:9090/default
LAA_OAUTH2_AUDIENCE=api://laa-info-and-advice-datastore

# For development against a real Entra app registration:
# LAA_OAUTH2_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
# LAA_OAUTH2_AUDIENCE=<application-id>

# Application ID of a trusted caller (e.g. RCW API) whose forwarded X-Authorization token this
# API also accepts. Defaults to the mock OAuth2 server's audience if unset.
# TRUSTED_CALLER_AUDIENCE=<application-id>
