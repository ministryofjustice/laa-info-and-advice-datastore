# Entra-specific overrides for validating real Entra ID tokens (issued to RCW, or forwarded by
# RCW API) instead of the default mock-oauth2-server.
#
# Not needed for the default full docker-compose stack - defaults in docker-compose.yml /
# include.api.yml apply if unset.
#
# Keep these values aligned with the matching entries in the sibling repos' own .env.entra
# files (../laa-record-controlled-work/.env.entra, ../laa-record-controlled-work-api/.env.entra)
# - mismatched tenant/audience values here are a common source of hard-to-diagnose auth errors.
#
# https://developer.1password.com/docs/cli/secret-reference-syntax

LAA_OAUTH2_ISSUER_URI="op://LAA Record Controlled Work/DS-API/ENTRA_ISSUER"
LAA_OAUTH2_AUDIENCE="op://LAA Record Controlled Work/DS-API/ENTRA_CLIENT_ID"

# Application ID of a trusted caller (e.g. RCW API) whose forwarded X-Authorization token this
# API also accepts. Must match RCW API's own AUDIENCE in ../laa-record-controlled-work-api/.env.entra.
TRUSTED_CALLER_AUDIENCE="op://LAA Record Controlled Work/RCW-API/ENTRA_CLIENT_ID"
