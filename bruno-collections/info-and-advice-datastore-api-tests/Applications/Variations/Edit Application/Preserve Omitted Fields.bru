meta {
  name: Preserve Omitted Fields
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/v0/applications/{{applicationId}}:edit-application
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 1,
    "meansAssessmentRequired": true,
    "clientDetails": {
      "firstName": "Updated first name"
    }
  }
}

script:pre-request {
  await bru.runRequest("Applications/Variations/Edit Application/Seed Application");
}

tests {
  test("sparse edit succeeds and increments the ETag once", function() {
    expect(res.getStatus()).to.equal(204);
    expect(res.getHeader("etag")).to.equal('"2"');
  });

  await test("omitted nullable properties preserve their values", async function() {
    const application = (await bru.runRequest("Applications/Get Application")).data;
    expect(application.reasonForReapplication).to.equal("Retained root reason");
    expect(application.ecfFlag).to.equal(true);
    expect(application.scopingQuestions).to.deep.equal({
      priorLegalAid: "same_matter",
      priorLegalAidReason: "Existing reason",
      unrelatedAnswer: "keep"
    });
    expect(application.client.niNumber).to.equal("AB123456A");
    expect(application.client.address.addressLine1).to.equal("10 Downing Street");
    expect(application.client.address.addressLine2).to.equal("Old line 2");
    expect(application.client.address.country).to.equal("GB");
  });
}