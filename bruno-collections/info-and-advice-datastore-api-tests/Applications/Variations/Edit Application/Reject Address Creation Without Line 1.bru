meta {
  name: Reject Address Creation Without Line 1
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/api/v0/applications/{{applicationId}}:edit-application
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 2,
    "clientDetails": {
      "noFixedAbode": false,
      "address": {
        "country": "GB"
      }
    }
  }
}

script:pre-request {
  await bru.runRequest("Applications/Variations/Edit Application/Unlink Address");
}

tests {
  test("creating an address without addressLine1 is rejected", function() {
    expect(res.getStatus()).to.equal(400);
  });

  await test("the rejected creation keeps the no-address state", async function() {
    const application = (await bru.runRequest("Applications/Get Application")).data;
    expect(application.eTag).to.equal(2);
    expect(application.client.noFixedAbode).to.equal(true);
    expect(application.client.address == null).to.equal(true);
  });
}