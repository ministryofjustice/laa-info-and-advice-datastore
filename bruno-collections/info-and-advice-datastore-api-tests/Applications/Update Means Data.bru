script:pre-request {
  if (!bru.getEnvVar("token")) {
    await bru.runRequest("Get Authentication Token");
  }
  const startApplicationRes = await bru.runRequest("Applications/Start Application");
  bru.setVar("applicationId", startApplicationRes.data.id);
}

tests {
  test("status is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });

  test("ETag header is present", function() {
    expect(res.getHeader("etag")).to.exist;
  });

  await test("means data and CFE result are reflected on the application unchanged", async function() {
    const sentResult = req.getBody().result;
    const getApplicationRes = await bru.runRequest("Applications/Get Application");
    const application = getApplicationRes.data;
    expect(application.eligibilityAssessment.data.client_age).to.equal("18-24");
    expect(application.eligibilityAssessment.result).to.deep.equal(sentResult);
    expect(application.eligibilityResult.data).to.deep.equal(application.eligibilityAssessment.data);
    expect(application.eligibilityResult.result).to.deep.equal(sentResult);
  });
}

docs {
  Updates the means assessment data for an application created fresh by the pre-request script
  (Start Application), whose id is stored in a local `applicationId` runtime variable. The `result`
  body is a CFE v6 response captured by CCQ (synthetic data).
}
