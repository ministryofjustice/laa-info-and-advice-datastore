meta {
  name: Update Means Data
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v0/applications/{{applicationId}}:update-means-data
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 0,
    "data": {
      "question": "answer"
    },
    "result": {
      "status": "ELIGIBLE"
    }
  }
}

script:pre-request {
  await bru.runRequest("Get Token");
  const startApplicationRes = await bru.runRequest("Applications/Start Application");
  bru.setVar("applicationId", startApplicationRes.data.id);
}

tests {
  test("status is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });

  test("ETag header is present", function() {
    expect(res.getHeader("etag")).to.exist;
  });

  await test("means data is reflected on the application", async function() {
    const getApplicationRes = await bru.runRequest("Applications/Get Application");
    const application = getApplicationRes.data;
    expect(application.eligibilityResult.data.question).to.equal("answer");
    expect(application.eligibilityResult.result.status).to.equal("ELIGIBLE");
  });
}

docs {
  Updates the means assessment data for an application created fresh by the pre-request script
  (Start Application), whose id is stored in a local `applicationId` runtime variable.
}
