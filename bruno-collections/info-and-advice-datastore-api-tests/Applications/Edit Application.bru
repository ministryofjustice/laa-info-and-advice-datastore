meta {
  name: Edit Application
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v0/applications/{{applicationId}}:edit-application
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 0,
    "ufn": "123456789",
    "laaReference": "LAA-REF-001",
    "reasonForReapplication": "Change of circumstances",
    "meansAssessmentRequired": true,
    "typeOfNonMeans": true,
    "ecfFlag": true,
    "contribution": "50.00",
    "determinationId": "11111111-1111-1111-1111-111111111111",
    "scopingQuestions": {
      "question1": "answer1"
    },
    "clientDetails": {
      "firstName": "Jane",
      "lastName": "Doe",
      "dateOfBirth": "1990-01-01",
      "niNumber": "AB123456A",
      "noFixedAbode": false,
      "address": {
        "addressLine1": "10 Downing Street",
        "addressLine2": "Westminster",
        "addressLine3": "Line 3",
        "addressLine4": "Line 4",
        "townOrCity": "London",
        "postCode": "SW1A 2AA",
        "county": "Greater London",
        "country": "GB"
      }
    },
    "declaration": {
      "declarationConfirmation": true,
      "dateSigned": "2024-01-01"
    },
    "evidence": {
      "evidenceExemptionCode": "EX1",
      "evidenceExemptionReason": "Exemption reason",
      "incomeEvidenceChecklist": {
        "payslips": true
      },
      "expenditureCapitalEvidenceChecklist": {
        "bankStatements": true
      }
    }
  }
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    await bru.runRequest("Get Authentication Token");
  }
  const startApplicationRes = await bru.runRequest("Applications/Start Application");
  bru.setVar("applicationId", startApplicationRes.data.id);
}

tests {
  test("status is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
  
  test("ETag header is present", function() {
    expect(res.getHeader("etag")).to.exist;
  });
  
  await test("edited fields are reflected on the application", async function() {
    const getApplicationRes = await bru.runRequest("Applications/Get Application");
    const application = getApplicationRes.data;
    expect(application.ufn).to.equal("123456789");
    expect(application.laaReference).to.equal("LAA-REF-001");
    expect(application.reasonForReapplication).to.equal("Change of circumstances");
    expect(application.meansAssessmentRequired).to.equal(true);
    expect(application.typeOfNonMeans).to.equal(true);
    expect(application.ecfFlag).to.equal(true);
    expect(application.contribution).to.equal("50.00");
    expect(application.determinationId).to.equal("11111111-1111-1111-1111-111111111111");
    expect(application.scopingQuestions).to.deep.equal({ question1: "answer1" });
  
    expect(application.client.firstName).to.equal("Jane");
    expect(application.client.lastName).to.equal("Doe");
    expect(application.client.dateOfBirth).to.equal("1990-01-01");
    expect(application.client.niNumber).to.equal("AB123456A");
    expect(application.client.noFixedAbode).to.equal(false);
    expect(application.client.address.addressLine1).to.equal("10 Downing Street");
    expect(application.client.address.addressLine2).to.equal("Westminster");
    expect(application.client.address.addressLine3).to.equal("Line 3");
    expect(application.client.address.addressLine4).to.equal("Line 4");
    expect(application.client.address.townOrCity).to.equal("London");
    expect(application.client.address.postCode).to.equal("SW1A 2AA");
    expect(application.client.address.county).to.equal("Greater London");
    expect(application.client.address.country).to.equal("GB");
  
    expect(application.declaration.declarationConfirmation).to.equal(true);
    expect(application.declaration.dateSigned).to.equal("2024-01-01");
  
    expect(application.evidence.evidenceExemptionCode).to.equal("EX1");
    expect(application.evidence.evidenceExemptionReason).to.equal("Exemption reason");
    expect(application.evidence.incomeEvidenceChecklist).to.deep.equal({ payslips: true });
    expect(application.evidence.expenditureCapitalEvidenceChecklist).to.deep.equal({
      bankStatements: true
    });
  });
}

docs {
  Edits every updatable property of an application (core fields, scoping questions, client
  details incl. nested address, declaration, and evidence) for an application created fresh
  by the pre-request script (Start Application), whose id is stored in a local `applicationId`
  runtime variable. Asserts every supplied field is reflected back via a Get Application call.
}
