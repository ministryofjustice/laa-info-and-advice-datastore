meta {
  name: Start Application
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v0/applications:start-application
  body: json
  auth: inherit
}

body:json {
  {
    "client": {
      "firstName": "John",
      "lastName": "Doe",
      "dateOfBirth": "1990-01-01",
      "noFixedAbode": false,
      "createAddressCommand": {
        "addressLine1": "10 Downing Street",
        "townOrCity": "London",
        "postCode": "SW1A 2AA",
        "country": "GB"
      }
    },
    "applicationType": "CLA",
    "providerOfficeCode": "123456"
  }
}

tests {
  test("status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Asserts that starting an application without a valid bearer token returns 401.
}
