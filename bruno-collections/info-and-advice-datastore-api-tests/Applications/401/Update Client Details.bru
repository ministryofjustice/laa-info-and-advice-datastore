meta {
  name: Update Client Details
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/v0/applications/00000000-0000-0000-0000-000000000000:update-client-details
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 0,
    "firstName": "Jane",
    "lastName": "Smith"
  }
}

tests {
  test("status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Asserts that updating a client's details without a valid bearer token returns 401. The id in
  the path is an arbitrary placeholder — auth is checked before the application is looked up.
}
