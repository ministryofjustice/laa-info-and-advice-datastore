meta {
  name: Update Application
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v0/applications/00000000-0000-0000-0000-000000000000:update-application
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 0,
    "applicationState": "COMPLETED"
  }
}

tests {
  test("status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Asserts that updating an application's state without a valid bearer token returns 401. The id
  in the path is an arbitrary placeholder — auth is checked before the application is looked up.
}
