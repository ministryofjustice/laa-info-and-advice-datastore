meta {
  name: Update Scoping Data
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v0/applications/00000000-0000-0000-0000-000000000000:update-scoping-data
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 0,
    "scopingQuestions": {
      "priorLegalAid": "same_matter",
      "priorLegalAidReason": "Previous matter was related"
    }
  }
}

tests {
  test("status is 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
}

docs {
  Asserts that updating scoping data without a valid bearer token returns 401. The id in the path
  is an arbitrary placeholder — auth is checked before the application is looked up.
}
