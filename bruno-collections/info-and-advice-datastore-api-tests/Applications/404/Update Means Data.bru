meta {
  name: Update Means Data
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/v0/applications/ffffffff-ffff-ffff-ffff-ffffffffffff:update-means-data
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 0,
    "data": {
      "question": "answer"
    },
    "result": {
      "status": "ELIGIBLE"
    }
  }
}

tests {
  test("status is 404", function() {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  Asserts that updating means data on a well-formed but non-existent applicationId returns 404 —
  the not-found check happens before the eTag is validated, so its value here doesn't matter.
}
