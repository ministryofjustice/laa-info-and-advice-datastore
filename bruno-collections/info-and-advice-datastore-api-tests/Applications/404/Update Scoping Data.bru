meta {
  name: Update Scoping Data
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v0/applications/ffffffff-ffff-ffff-ffff-ffffffffffff:update-scoping-data
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 0,
    "scopingQuestions": {
      "priorLegalAid": "same_matter",
      "priorLegalAidReason": "Previous matter was related"
    }
  }
}

tests {
  test("status is 404", function() {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  Asserts that updating scoping data on a well-formed but non-existent applicationId returns 404
  — the not-found check happens before the eTag is validated, so its value here doesn't matter.
}
