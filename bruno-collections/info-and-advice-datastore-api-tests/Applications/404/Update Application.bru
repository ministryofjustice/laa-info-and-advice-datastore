meta {
  name: Update Application
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v0/applications/ffffffff-ffff-ffff-ffff-ffffffffffff:update-application
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 0,
    "applicationState": "COMPLETED"
  }
}

tests {
  test("status is 404", function() {
    expect(res.getStatus()).to.equal(404);
  });
}

docs {
  Asserts that updating an application's state on a well-formed but non-existent applicationId
  returns 404 — the not-found check happens before the eTag is validated, so its value here
  doesn't matter.
}
