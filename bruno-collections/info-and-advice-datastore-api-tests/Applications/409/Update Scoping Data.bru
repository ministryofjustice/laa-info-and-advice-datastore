meta {
  name: Update Scoping Data
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v0/applications/{{applicationId}}:update-scoping-data
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 999,
    "scopingQuestions": {
      "priorLegalAid": "same_matter",
      "priorLegalAidReason": "Previous matter was related"
    }
  }
}

tests {
  test("status is 409", function() {
    expect(res.getStatus()).to.equal(409);
  });

  test("body is a problem detail describing the mismatch", function() {
    const body = res.getBody();
    expect(body.status).to.equal(409);
    expect(body.detail).to.contain("supplied 999").and.to.contain("expected 0");
  });
}

docs {
  Asserts that updating scoping data with a mismatched eTag (999, against a freshly created
  application whose real eTag is 0) returns 409.
}
