meta {
  name: Start Application
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v0/applications:start-application
  body: json
  auth: inherit
}

body:json {
  {
    "client": {
      "firstName": "John",
      "lastName": "Doe",
      "dateOfBirth": "1990-01-01",
      "noFixedAbode": false,
      "createAddressCommand": {
        "addressLine1": "10 Downing Street",
        "townOrCity": "London",
        "postCode": "SW1A 2AA",
        "country": "GB"
      }
    },
    "applicationType": "CLA",
    "providerOfficeCode": "123456",
    "providerContractType": "face-to-face",
    "categoryOfLaw": "family"
  }
}

script:pre-request {
  if (!bru.getEnvVar("token")) {
    await bru.runRequest("Get Authentication Token");
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("applicationId", res.body.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("body has a generated id and eTag", function() {
    const body = res.getBody();
    expect(body.id).to.be.a("string").and.not.empty;
    expect(body.eTag).to.be.a("number");
  });

  test("body contains provider contract type and category of law", function() {
    const body = res.getBody();
    expect(body.providerContractType).to.equal("face-to-face");
    expect(body.categoryOfLaw).to.equal("family");
  });
}

docs {
  Starts a new application for a client. On success, stores the created application's id in the
  `applicationId` environment variable for use by the other requests below.
}
