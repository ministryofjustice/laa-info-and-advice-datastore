meta {
  name: Update Scoping Data Omitted
  type: http
  seq: 24
}

patch {
  url: {{baseUrl}}/api/v0/applications/{{applicationId}}:update-scoping-data
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 1
  }
}

script:pre-request {
  await bru.runRequest("Applications/Variations/Edit Application/Seed Application");
}

tests {
  test("omitted scopingQuestions retains the existing operation behavior", function() {
    expect(res.getStatus()).to.equal(204);
  });

  await test("the omitted property writes JSON null", async function() {
    const application = (await bru.runRequest("Applications/Get Application")).data;
    expect(application.scopingQuestions).to.equal(null);
  });
}