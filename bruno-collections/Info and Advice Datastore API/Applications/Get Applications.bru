meta {
  name: Get Applications
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v0/applications?page=0&size=25
  body: none
  auth: inherit
}

script:pre-request {
  await bru.runRequest("Get Token");

  const createdApplicationIds = [];
  for (let i = 0; i < 3; i++) {
    const startApplicationRes = await bru.runRequest("Applications/Start Application");
    createdApplicationIds.push(startApplicationRes.data.id);
    await bru.sleep(50); // ensure each application gets a distinct, increasing modifiedAt
  }
  bru.setVar("createdApplicationIds", createdApplicationIds);
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("body is a page of application summaries", function() {
    const body = res.getBody();
    expect(body.content).to.be.an("array");
    expect(body.page).to.be.a("number");
    expect(body.size).to.be.a("number");
    expect(body.totalElements).to.be.a("number");
    expect(body.totalPages).to.be.a("number");
  });

  test("created applications are returned in modifiedAt descending order", function() {
    const createdApplicationIds = bru.getVar("createdApplicationIds");
    const content = res.getBody().content;
    const createdIds = new Set(createdApplicationIds);
    const createdEntries = content.filter((application) => createdIds.has(application.id));

    // Most recently created application should appear first.
    expect(createdEntries.map((application) => application.id)).to.eql(
      [...createdApplicationIds].reverse()
    );

    for (let i = 0; i < createdEntries.length - 1; i++) {
      const current = new Date(createdEntries[i].modifiedAt).getTime();
      const next = new Date(createdEntries[i + 1].modifiedAt).getTime();
      expect(current).to.be.at.least(next);
    }
  });
}

docs {
  Get a paginated list of applications. The pre-request script creates three fresh applications
  via Start Application (spaced apart so each gets a distinct `modifiedAt`) and stores their ids
  in a local `createdApplicationIds` runtime variable. Optional query params: `officeId`,
  `status` (DRAFT | COMPLETED).
}
