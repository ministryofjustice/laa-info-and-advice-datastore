meta {
  name: Update Application
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v0/applications/{{applicationId}}:update-application
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 0,
    "applicationState": "COMPLETED"
  }
}

script:pre-request {
  await bru.runRequest("Get Token");
  const startApplicationRes = await bru.runRequest("Applications/Start Application");
  bru.setVar("applicationId", startApplicationRes.data.id);
}

tests {
  test("status is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });

  test("ETag header is present", function() {
    expect(res.getHeader("etag")).to.exist;
  });
}

docs {
  Updates the application's overall state (e.g. DRAFT -> COMPLETED) for an application created
  fresh by the pre-request script (Start Application), whose id is stored in a local
  `applicationId` runtime variable.
}
