meta {
  name: Update Scoping Data
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v0/applications/{{applicationId}}:update-scoping-data
  body: json
  auth: inherit
}

body:json {
  {
    "eTag": 0,
    "scopingQuestions": {
      "priorLegalAid": "same_matter",
      "priorLegalAidReason": "Previous matter was related"
    }
  }
}

script:pre-request {
  await bru.runRequest("Get Token");
  const startApplicationRes = await bru.runRequest("Applications/Start Application");
  bru.setVar("applicationId", startApplicationRes.data.id);
}

tests {
  test("status is 204", function() {
    expect(res.getStatus()).to.equal(204);
  });

  test("ETag header is present", function() {
    expect(res.getHeader("etag")).to.exist;
  });

  await test("scoping data is reflected on the application", async function() {
    const getApplicationRes = await bru.runRequest("Applications/Get Application");
    const application = getApplicationRes.data;
    expect(application.scopingQuestions.priorLegalAid).to.equal("same_matter");
    expect(application.scopingQuestions.priorLegalAidReason).to.equal("Previous matter was related");
  });
}

docs {
  Updates the scoping questions/answers for an application created fresh by the pre-request
  script (Start Application), whose id is stored in a local `applicationId` runtime variable.
}
