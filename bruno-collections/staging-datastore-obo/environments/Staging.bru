  tokenUrl: {{process.env.STAGING_ENTRA_TOKEN_URL}}
  datastoreScope: {{process.env.STAGING_DATASTORE_SCOPE}}
  uiClientId: {{process.env.STAGING_RCW_CLIENT_ID}}
  uiClientSecret: {{process.env.STAGING_RCW_CLIENT_SECRET}}
  apiClientId: {{process.env.STAGING_RCW_API_CLIENT_ID}}
  apiClientSecret: {{process.env.STAGING_RCW_API_CLIENT_SECRET}}
}
